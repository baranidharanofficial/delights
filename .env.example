# --- POS Google SSO ---------------------------------------------------------
# Google Cloud console → APIs & Services → Credentials → OAuth client ID
# Application type: "Web application"
#   Authorised redirect URI (dev):  http://localhost:3000/api/auth/google/callback
#   Authorised redirect URI (prod): https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the POS session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Comma-separated allowlist of Google accounts permitted to open /pos.
# Defaults to baranidharanofficial@gmail.com when unset.
# POS_ALLOWED_EMAILS=baranidharanofficial@gmail.com

# Optional. Set only when the public origin differs from the request host
# (e.g. behind a proxy that rewrites Host). Must match the redirect URI above.
# APP_ORIGIN=https://your-domain.com

# --- Firestore --------------------------------------------------------------
# Firebase console → Project settings → Service accounts → "Generate new private
# key". The downloaded JSON holds all three values below.
#
# These credentials are server-side only and bypass Firestore security rules by
# design — never expose them to the browser, and never prefix them NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

# Paste the JSON's "private_key" value verbatim, including the literal \n
# sequences and the surrounding quotes:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
