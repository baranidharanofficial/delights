rules_version = '2';

// Every read and write goes through the Next.js server using the Admin SDK,
// which bypasses these rules entirely. No browser ever holds a Firebase
// identity for this project, so direct client access is denied outright rather
// than left at the default (which expires into open access after 30 days).
//
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
